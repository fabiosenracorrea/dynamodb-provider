{
  "name": "dynamodb-provider-playground",
  "version": "0.0.1",
  "description": "Development playground for DynamoDB Provider",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dynamodb-playground": "./bin/cli.js"
  },
  "main": "./src/cli.ts",
  "files": [
    "src",
    "bin",
    "dist/client",
    "tsconfig.json",
    "tailwind.config.js",
    "tailwind.theme.js",
    "postcss.config.js"
  ],
  "scripts": {
    "dev": "yarn clean && tsx src/cli.ts",
    "clean": "rm -rf ./dist",
    "build": "vite build",
    "build-all": "yarn clean && yarn check-ts && yarn lint && yarn build",
    "build-publish": "yarn build-all && npm publish",
    "pack": "yarn build-all && npm pack",
    "check-ts": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "setup:local": "tsx scripts/setup-local-table.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.17.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.294.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "dynamodb-provider": "^3.1.2",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.8.2",
    "eslint-plugin-jest-dom": "^4.0.2",
    "eslint-plugin-jsx-a11y": "^6.6.0",
    "eslint-plugin-prettier": "5.0.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-testing-library": "^5.6.0",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14"
  },
  "peerDependencies": {
    "dynamodb-provider": ">=3.0.0"
  }
}
